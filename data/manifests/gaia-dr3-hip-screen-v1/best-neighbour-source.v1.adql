SELECT
  x.original_ext_source_id AS hip_id,
  x.source_id AS gaia_source_id,
  x.angular_distance AS best_angular_distance_arcsec,
  x.number_of_neighbours,
  x.xm_flag AS best_xm_flag,
  g.solution_id,
  g.designation,
  g.ref_epoch,
  g.ra,
  g.ra_error,
  g.dec,
  g.dec_error,
  g.parallax,
  g.parallax_error,
  g.parallax_over_error,
  g.pmra,
  g.pmra_error,
  g.pmdec,
  g.pmdec_error,
  g.ra_dec_corr,
  g.ra_parallax_corr,
  g.ra_pmra_corr,
  g.ra_pmdec_corr,
  g.dec_parallax_corr,
  g.dec_pmra_corr,
  g.dec_pmdec_corr,
  g.parallax_pmra_corr,
  g.parallax_pmdec_corr,
  g.pmra_pmdec_corr,
  g.nu_eff_used_in_astrometry,
  g.pseudocolour,
  g.pseudocolour_error,
  g.ra_pseudocolour_corr,
  g.dec_pseudocolour_corr,
  g.parallax_pseudocolour_corr,
  g.pmra_pseudocolour_corr,
  g.pmdec_pseudocolour_corr,
  g.astrometric_params_solved,
  g.astrometric_primary_flag,
  g.astrometric_n_obs_al,
  g.astrometric_n_obs_ac,
  g.astrometric_n_good_obs_al,
  g.astrometric_n_bad_obs_al,
  g.astrometric_gof_al,
  g.astrometric_chi2_al,
  g.astrometric_excess_noise,
  g.astrometric_excess_noise_sig,
  g.astrometric_matched_transits,
  g.visibility_periods_used,
  g.astrometric_sigma5d_max,
  g.ipd_gof_harmonic_amplitude,
  g.ipd_gof_harmonic_phase,
  g.ipd_frac_multi_peak,
  g.ipd_frac_odd_win,
  g.ruwe,
  g.duplicated_source,
  g.phot_g_n_obs,
  g.phot_g_mean_mag,
  g.radial_velocity,
  g.radial_velocity_error,
  g.rv_method_used,
  g.rv_nb_transits,
  g.rv_nb_deblended_transits,
  g.rv_visibility_periods_used,
  g.rv_expected_sig_to_noise,
  g.rv_renormalised_gof,
  g.rv_chisq_pvalue,
  g.rv_time_duration,
  g.rv_amplitude_robust,
  g.rv_template_teff,
  g.rv_template_logg,
  g.rv_template_fe_h,
  g.rv_atm_param_origin,
  g.grvs_mag,
  g.grvs_mag_error,
  g.grvs_mag_nb_transits,
  g.rvs_spec_sig_to_noise,
  g.phot_variable_flag,
  g.non_single_star,
  g.has_rvs,
  g.has_epoch_rv,
  g.has_epoch_photometry
FROM gaiadr3.hipparcos2_best_neighbour AS x
JOIN gaiadr3.gaia_source AS g
  ON g.source_id = x.source_id
WHERE x.original_ext_source_id IN (
  746,
  3179,
  4427,
  6686,
  8886,
  11767,
  53910,
  54061,
  58001,
  59774,
  62956,
  65378,
  67301,
  72607,
  75097,
  77055,
  79822,
  82080,
  85822
)
ORDER BY x.original_ext_source_id, x.source_id
