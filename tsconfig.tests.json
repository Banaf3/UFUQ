{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@playwright/test"]
  },
  "include": [
    "apps/**/*.test.ts",
    "packages/**/*.test.ts",
    "tools/**/*.test.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
