{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ufuq:synthetic-astronomy-output:v1",
  "title": "UFUQ synthetic-only astronomy oracle output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureClassification",
    "claimScope",
    "generator",
    "conventions",
    "networkPolicy",
    "serializationPolicy",
    "environmentEvidence",
    "environmentWarnings",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ufuq.synthetic-astronomy-output.v1"
    },
    "fixtureClassification": {
      "const": "SYNTHETIC_ONLY"
    },
    "claimScope": {
      "const": "ENVIRONMENT_AND_ORACLE_PATH_SMOKE_ONLY"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "conventions": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "serializationPolicy": { "type": "object" },
    "environmentEvidence": { "type": "object" },
    "environmentWarnings": { "type": "array" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["caseId", "classification", "validity", "warnings"]
      }
    }
  }
}
