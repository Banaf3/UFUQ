{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ufuq:astronomy-experiment-result:v1",
  "title": "UFUQ astronomy experiment result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "fixtureId",
    "caseId",
    "resultClassification",
    "executionOutcome",
    "executionManifest",
    "measurements",
    "warnings",
    "structuredStatuses",
    "checks",
    "errorBudgetStatus",
    "decisionLimits",
    "canonicalContentSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ufuq.astronomy-experiment-result.v1"
    },
    "experimentId": { "$ref": "#/$defs/runnableExperimentId" },
    "fixtureId": {
      "type": "string",
      "pattern": "^2C\\.[1-4]-EXP-[0-9]{2}:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resultClassification": {
      "const": "SYNTHETIC_EXPERIMENT_EVIDENCE_ONLY"
    },
    "executionOutcome": { "$ref": "#/$defs/executionOutcome" },
    "executionManifest": { "$ref": "#/$defs/executionManifest" },
    "measurements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/measurement" }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/statusRecord" }
    },
    "structuredStatuses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/statusRecord" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/check" }
    },
    "errorBudgetStatus": {
      "const": "NOT_ESTABLISHED_AST_006_OPEN"
    },
    "decisionLimits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalContentSha256": {
      "description": "SHA-256 of UFUQ_CANONICAL_JSON_V1 bytes for the result object with this field omitted. The complete serialized file hash is a separate companion artifact because it cannot be embedded without self-reference.",
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionOutcome": {
            "properties": { "state": { "const": "COMPLETED" } },
            "required": ["state"]
          }
        },
        "required": ["executionOutcome"]
      },
      "then": {
        "properties": {
          "executionOutcome": {
            "properties": { "reasons": { "maxItems": 0 } }
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "enum": ["PASS", "FAIL", "MEASURED_NO_ACCEPTANCE"]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "executionOutcome": {
            "properties": { "reasons": { "minItems": 1 } }
          },
          "measurements": { "maxItems": 0 },
          "checks": {
            "items": {
              "properties": { "status": { "const": "NOT_RUN" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runnableExperimentId": {
      "enum": [
        "2C.1-EXP-01",
        "2C.1-EXP-02",
        "2C.1-EXP-03",
        "2C.2-EXP-01",
        "2C.2-EXP-03",
        "2C.2-EXP-04",
        "2C.2-EXP-06",
        "2C.3-EXP-01",
        "2C.3-EXP-02",
        "2C.3-EXP-04",
        "2C.3-EXP-05",
        "2C.4-EXP-02",
        "2C.4-EXP-03",
        "2C.4-EXP-04",
        "2C.4-EXP-05",
        "2C.4-EXP-06",
        "2C.4-EXP-07"
      ]
    },
    "executionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons"],
      "properties": {
        "state": {
          "enum": ["COMPLETED", "BLOCKED", "SKIPPED", "EXECUTION_ERROR"]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/statusRecord" }
        }
      }
    },
    "executionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "experimentId",
        "fixtureId",
        "caseId",
        "protocolVersion",
        "registryVersion",
        "fixtureSchemaVersion",
        "resultSchemaVersion",
        "hashes",
        "softwareRuntime",
        "runtimeContext",
        "runner",
        "comparisonLineage",
        "networkPolicy",
        "cachePolicy",
        "externalArtifactProvenance",
        "repetitionCount",
        "canonicalSerialization",
        "recordOrdering"
      ],
      "properties": {
        "manifestVersion": {
          "const": "ufuq.astronomy-experiment-execution-manifest.v1"
        },
        "experimentId": { "$ref": "#/$defs/runnableExperimentId" },
        "fixtureId": {
          "type": "string",
          "pattern": "^2C\\.[1-4]-EXP-[0-9]{2}:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "caseId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "protocolVersion": { "const": "2C.5A-v1" },
        "registryVersion": {
          "const": "ufuq.astronomy-experiment-registry.v1"
        },
        "fixtureSchemaVersion": {
          "const": "ufuq.astronomy-experiment-fixture.v1"
        },
        "resultSchemaVersion": {
          "const": "ufuq.astronomy-experiment-result.v1"
        },
        "hashes": { "$ref": "#/$defs/executionHashes" },
        "softwareRuntime": { "$ref": "#/$defs/softwareRuntime" },
        "runtimeContext": { "$ref": "#/$defs/runtimeContext" },
        "runner": { "$ref": "#/$defs/runner" },
        "comparisonLineage": {
          "enum": [
            "STRUCTURAL_INVARIANT",
            "SAME_ERFA_SOFA_FAMILY",
            "CODE_INDEPENDENT_SHARED_MODEL",
            "POLICY_SENSITIVITY_NO_INDEPENDENT_COMPARISON",
            "INDEPENDENT_MODEL_REQUIRED",
            "PRODUCTION_COMPARISON_REQUIRED"
          ]
        },
        "networkPolicy": {
          "const": "OFFLINE_AUTO_DOWNLOAD_DISABLED"
        },
        "cachePolicy": {
          "const": "FRESH_ISOLATED_CACHE_NO_DISCOVERY"
        },
        "externalArtifactProvenance": {
          "type": "array",
          "description": "Only external artifacts actually consumed are listed. Purely synthetic cases may use an empty array; explicit synthetic EOP, meteorology, observer, and ephemeris values remain provenance-labelled inside the fixture.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/externalArtifact" }
        },
        "repetitionCount": {
          "type": "integer",
          "minimum": 2
        },
        "canonicalSerialization": {
          "const": "UFUQ_CANONICAL_JSON_V1"
        },
        "recordOrdering": {
          "const": "REGISTRY_ID_GROUP_MEMBER_INPUT_KEY_MEASUREMENT_ID_STATUS_SEQUENCE_CHECK_ID"
        }
      }
    },
    "executionHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolDocumentSha256",
        "registrySha256",
        "registrySchemaSha256",
        "fixtureSchemaSha256",
        "resultSchemaSha256",
        "environmentManifestSha256",
        "lockfileSha256",
        "fixtureByteLength",
        "fixtureSha256"
      ],
      "properties": {
        "protocolDocumentSha256": { "$ref": "#/$defs/sha256" },
        "registrySha256": { "$ref": "#/$defs/sha256" },
        "registrySchemaSha256": { "$ref": "#/$defs/sha256" },
        "fixtureSchemaSha256": { "$ref": "#/$defs/sha256" },
        "resultSchemaSha256": { "$ref": "#/$defs/sha256" },
        "environmentManifestSha256": { "$ref": "#/$defs/sha256" },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "fixtureByteLength": { "type": "integer", "minimum": 0 },
        "fixtureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "softwareRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pythonVersion",
        "uvVersion",
        "astropyVersion",
        "pyerfaVersion",
        "pyerfaDependencyKind",
        "erfaVersion",
        "sofaIssue",
        "astropyIersDataVersion",
        "directlyImportedPackages"
      ],
      "properties": {
        "pythonVersion": { "const": "3.14.6" },
        "uvVersion": { "const": "0.11.32" },
        "astropyVersion": { "const": "8.0.1" },
        "pyerfaVersion": { "const": "2.0.1.5" },
        "pyerfaDependencyKind": { "enum": ["TRANSITIVE", "DIRECT"] },
        "erfaVersion": { "const": "2.0.1" },
        "sofaIssue": { "const": "20231011" },
        "astropyIersDataVersion": { "const": "0.2026.7.20.15.31.18" },
        "directlyImportedPackages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "operatingSystemVersion",
        "architecture",
        "pythonImplementation"
      ],
      "properties": {
        "operatingSystem": { "type": "string", "minLength": 1 },
        "operatingSystemVersion": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "pythonImplementation": { "const": "CPython" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerId",
        "runnerVersion",
        "entryPoint",
        "argv",
        "workingDirectory",
        "sourceFiles"
      ],
      "properties": {
        "runnerId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "runnerVersion": { "type": "string", "minLength": 1 },
        "entryPoint": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "workingDirectory": { "const": "tools/astronomy-reference" },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceFileHash" }
        }
      }
    },
    "sourceFileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "externalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifactId", "version", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "EARTH_ORIENTATION",
            "LEAP_SECONDS",
            "EPHEMERIS",
            "METEOROLOGY",
            "OBSERVER",
            "OTHER"
          ]
        },
        "artifactId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementId", "metric", "unit", "value", "acceptanceStatus"],
      "properties": {
        "measurementId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "metric": {
          "enum": [
            "GREAT_CIRCLE_ANGULAR_SEPARATION",
            "WRAPPED_AZIMUTH_DIFFERENCE",
            "ALTITUDE_DIFFERENCE",
            "COMPONENT_RESIDUAL",
            "DETERMINISTIC_BYTE_LENGTH",
            "DETERMINISTIC_SHA256"
          ]
        },
        "unit": { "type": "string", "minLength": 1 },
        "value": {},
        "acceptanceStatus": {
          "const": "MEASURED_NO_ACCEPTANCE"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric": { "const": "DETERMINISTIC_SHA256" }
            },
            "required": ["metric"]
          },
          "then": {
            "properties": {
              "unit": { "const": "SHA256_HEX" },
              "value": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": { "const": "DETERMINISTIC_BYTE_LENGTH" }
            },
            "required": ["metric"]
          },
          "then": {
            "properties": {
              "unit": { "const": "BYTE" },
              "value": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "metric": { "const": "COMPONENT_RESIDUAL" } },
            "required": ["metric"]
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  { "type": "number" },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "number" }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "enum": [
                  "GREAT_CIRCLE_ANGULAR_SEPARATION",
                  "WRAPPED_AZIMUTH_DIFFERENCE",
                  "ALTITUDE_DIFFERENCE"
                ]
              }
            },
            "required": ["metric"]
          },
          "then": {
            "properties": { "value": { "type": "number" } }
          }
        }
      ]
    },
    "statusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "code", "severity", "message", "sequenceIndex"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["INFO", "WARNING", "ERROR"] },
        "message": { "type": "string", "minLength": 1 },
        "sequenceIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "kind",
        "status",
        "basis",
        "basisClassification",
        "numericalThreshold"
      ],
      "properties": {
        "checkId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["EXACT_INVARIANT", "MEASUREMENT_ONLY"]
        },
        "status": {
          "enum": ["PASS", "FAIL", "MEASURED_NO_ACCEPTANCE", "NOT_RUN"]
        },
        "basis": { "type": "string", "minLength": 1 },
        "basisClassification": {
          "enum": ["SOURCE_SUPPORTED_FACT", "PROJECT_DECISION", "MEASUREMENT_PROTOCOL"]
        },
        "numericalThreshold": {
          "description": "Required null means a numerical acceptance threshold is prohibited in schema v1; missing and null are not interchangeable.",
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "EXACT_INVARIANT" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "basisClassification": {
                "enum": ["SOURCE_SUPPORTED_FACT", "PROJECT_DECISION"]
              },
              "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }
            }
          },
          "else": {
            "properties": {
              "basisClassification": {
                "const": "MEASUREMENT_PROTOCOL"
              },
              "status": {
                "enum": ["MEASURED_NO_ACCEPTANCE", "NOT_RUN"]
              }
            }
          }
        }
      ]
    }
  }
}
